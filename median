class Solution:
    def findMedianSortedArrays(self, nums1: list[int], nums2: list[int]) -> float:
        val=0.00
        new = nums1+nums2
        new.sort()
        if len(new)%2!=0:
            val = new[len(new)//2]
        else:
            val = (new[len(new)//2-1]+new[len(new)//2])/2
        return val
